# Optional CDN base URL for homepage cinematic videos.
# Leave empty to use local files from /public/videos.
# Example: https://cdn.yourdomain.com
NEXT_PUBLIC_MEDIA_CDN_BASE=

# Preferred homepage video formats, in order.
# For your current local setup use mp4.
# Example when you add WebM later: webm,mp4
NEXT_PUBLIC_HOME_VIDEO_FORMATS=mp4

# Optional: set to false to disable fallback telemetry event when a panel video
# fails and switches to poster-only mode.
NEXT_PUBLIC_ENABLE_VIDEO_FALLBACK_TELEMETRY=true
